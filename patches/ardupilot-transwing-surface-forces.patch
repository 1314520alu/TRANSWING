+uint16_t average_servo_pwm(uint16_t a, uint16_t b)
+{
+    if (a == 0) {
+        a = 1500;
+    }
+    if (b == 0) {
+        b = 1500;
+    }
+    return uint16_t((uint32_t(a) + uint32_t(b)) / 2U);
+}
+
+void build_surface_input(const struct sitl_input &input, struct sitl_input &surface_input)
+{
+    surface_input = input;
+    // Plane::calculate_forces reads RC-style channels from servos[0..3].
+    // Transwing uses SERVO5-10 for control surfaces, not SERVO1-4 motors.
+    surface_input.servos[0] = average_servo_pwm(input.servos[AILERON_SERVO_A], input.servos[AILERON_SERVO_A + 1]);
+    surface_input.servos[1] = average_servo_pwm(input.servos[ELEVATOR_SERVO_A], input.servos[ELEVATOR_SERVO_A + 1]);
+    surface_input.servos[2] = 1000;
+    surface_input.servos[3] = average_servo_pwm(input.servos[RUDDER_SERVO_A], input.servos[RUDDER_SERVO_A + 1]);
+}
+
+void calculate_transwing_surfaces(const struct sitl_input &input,
+                                  float &aileron_norm,
+                                  float &elevator_norm,
+                                  float &rudder_norm)
+{
+    struct sitl_input surface_input;
+    build_surface_input(input, surface_input);
+    aileron_norm = constrain_float((float(surface_input.servos[0]) - 1500.0f) / 500.0f, -1.0f, 1.0f);
+    elevator_norm = constrain_float((float(surface_input.servos[1]) - 1500.0f) / 500.0f, -1.0f, 1.0f);
+    rudder_norm = constrain_float((float(surface_input.servos[3]) - 1500.0f) / 500.0f, -1.0f, 1.0f);
+}
